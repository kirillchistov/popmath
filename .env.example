# Секрет для подписи сессионных cookie (минимум 32 символа)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Список пользователей: login:password:role через запятую
# role = student | tutor; если роль не указана, считается student
# Без запятой и двоеточия внутри пароля
AUTH_USERS=demo:demo@demo5678:student,kirill:changeme:tutor
