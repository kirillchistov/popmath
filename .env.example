# Секрет для подписи сессионных cookie (минимум 32 символа)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Список пользователей: login:password:role через запятую
# role = student | tutor; если роль не указана, считается student
# Без запятой и двоеточия внутри пароля
AUTH_USERS=demo:demo@demo5678:student,kirill:changeme:tutor

# Секрет для еженедельного cron дайджеста (Authorization: Bearer ...)
CRON_SECRET=change-me-digest-cron-secret-at-least-16

# Приватный Vercel Blob. Если задан токен или BLOB_STORE_ID, попытки, планы,
# задачи тьютора и фото пишутся туда. На сайте те же переменные нужны в Environment Variables.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Каталог JSON, если Blob не подключён. На Vercel без Blob пишем в /tmp и записи пропадают.
# DATA_DIR=/var/data/mateshka

# Куда слать жалобы «в тренажёре ошибка». Без ключа запись всё равно идёт в журнал на /tutor
ADMIN_EMAIL=you@example.com
RESEND_API_KEY=
MAIL_FROM=Матешка <onboarding@resend.dev>

# Яндекс AI Studio для «Помощь с ДЗ». Folder ID должен совпадать с каталогом сервисного аккаунта ключа
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=deepseek-v4.1-flash/latest
# YANDEX_VISION_MODEL=qwen3.6-35b-a3b/latest
